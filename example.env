# Copy to `.env` on the server and edit values.
#   cp example.env .env

# Required — used by the birthday page builder
NAME='Stellar'
PIC='sample-pic.jpeg'

# Optional overrides for the birthday page
# NICKNAME='Star'
# HBD_MSG='Happy Birthday, my love'
# SCROLL_MSG='sample-scroll.txt'
# OPEN_DATE='2026-09-27'

# Host port the docker service publishes.
# Default 8080; change if you already run something on 8080.
# HOST_PORT=8080
